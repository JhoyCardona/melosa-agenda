generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  pushToken    String?
  createdAt    DateTime @default(now())
}

model Order {
  id                     String      @id @default(uuid())
  ticketNumber           Int         @unique @default(autoincrement())
  clientName             String
  clientPhone            String
  deliveryDate           DateTime    @db.Date
  // Delivery is scheduled on a continuous per-day timeline, 2:00pm-7:00pm
  // (minutes 0-300). deliveryStartMinutes = where this order starts,
  // deliveryDurationMin = how long it occupies (sum of variant prepMinutes,
  // rounded up to 5). The customer-facing pickup time is start + duration.
  deliveryStartMinutes   Int
  deliveryDurationMin    Int
  deliveryAddress        String?
  totalPrice             Decimal     @default(0)
  depositPaid            Decimal     @default(0)
  requiredPaymentPercent Int         @default(100)
  paymentDueDate         DateTime?
  notes                  String?
  status                 OrderStatus @default(AWAITING_PAYMENT)
  source                 OrderSource @default(MANUAL)
  notifiedAt             DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  items OrderItem[]
}

model OrderItem {
  id              String          @id @default(uuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Catalog link — null for a fully custom line entered from the admin order
  // form (personalized cakes not in the catalog). customName/customFlavor carry
  // the hand-typed values; priceAtOrder still holds the price either way.
  productDesignId String?
  productDesign   ProductDesign?  @relation(fields: [productDesignId], references: [id], onDelete: Restrict)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  priceAtOrder    Decimal
  pointsAtOrder   Int
  flavor          Flavor?
  customName      String?
  customFlavor    String?
  customImageUrl  String?
  customText      String?
  // Shape snapshot (from ProductDesign.shape, or hand-typed for a free line) and
  // filling, mandatory on every order item going forward. customSize is the
  // free-text portions ("20 porciones") for a free line only — catalog lines get
  // their size from variant.label.
  shape           String?
  relleno         String?
  customSize      String?
  createdAt       DateTime        @default(now())
}

model ProductDesign {
  id                     String       @id @default(uuid())
  name                   String
  category               ItemCategory
  shape                  String?
  imageUrl               String?
  allowsCustomImage      Boolean      @default(false)
  allowsCustomText       Boolean      @default(true)
  // Deposit policy: percent of the total this design requires up front. An order
  // snapshots the max across its items into Order.requiredPaymentPercent.
  requiredPaymentPercent Int          @default(100)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  variants   ProductVariant[]
  orderItems OrderItem[]
}

model ProductVariant {
  id              String        @id @default(uuid())
  productDesignId String
  productDesign   ProductDesign @relation(fields: [productDesignId], references: [id], onDelete: Cascade)
  label           String
  price           Decimal
  points          Int
  // Minutes this variant consumes on the delivery timeline. Set per variant
  // from the admin catalog screen. Replaces `points` as the scheduling unit;
  // `points` stays only for historical OrderItem.pointsAtOrder records.
  prepMinutes     Int           @default(20)
  enPromocion     Boolean       @default(false)
  createdAt       DateTime      @default(now())

  orderItems OrderItem[]
}

// One row per delivery day. cursorMinutes is the end of that day's booking
// queue (0 = 2:00pm). It only ever moves forward: a cancelled order leaves its
// slot as a gap (rest time) and never pulls the cursor back. This row is also
// the lock point that serialises concurrent slot reservations for the same day.
model DaySchedule {
  id            String   @id @default(uuid())
  date          DateTime @unique @db.Date
  // Minutes from midnight; 840 = 2:00pm (opening).
  cursorMinutes Int      @default(840)
}

enum OrderStatus {
  PENDING_REVIEW
  AWAITING_PAYMENT
  DEPOSIT_PAID
  FULLY_PAID
  COMPLETED
  CANCELLED
  EXPIRED
}

enum OrderSource {
  WEB_PUBLIC
  MANUAL
}

enum Flavor {
  VAINILLA
  CHOCOLATE
}

enum ItemCategory {
  CAKE
  ALFAJOR_CAKE
  ALFAJOR_UNIT
  CUPCAKE
  DESSERT
}
