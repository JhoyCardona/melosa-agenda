generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Order {
  id                     String      @id @default(uuid())
  ticketNumber           Int         @unique @default(autoincrement())
  clientName             String
  clientPhone            String
  deliveryDate           DateTime    @db.Date
  // Delivery is scheduled on a continuous per-day timeline, 2:00pm-8:30pm
  // (minutes-from-midnight 840-1230). deliveryStartMinutes = where this order starts,
  // deliveryDurationMin = how long it occupies (sum of variant prepMinutes,
  // rounded up to 5). The customer-facing pickup time is start + duration.
  deliveryStartMinutes   Int
  deliveryDurationMin    Int
  deliveryAddress        String?
  totalPrice             Decimal     @default(0)
  depositPaid            Decimal     @default(0)
  requiredPaymentPercent Int         @default(100)
  paymentDueDate         DateTime?
  notes                  String?
  status                 OrderStatus @default(AWAITING_PAYMENT)
  source                 OrderSource @default(MANUAL)
  notifiedAt             DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  items OrderItem[]
}

model OrderItem {
  id              String          @id @default(uuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Catalog link — null for a fully custom line entered from the admin order
  // form (personalized cakes not in the catalog). customName/customFlavor carry
  // the hand-typed values; priceAtOrder still holds the price either way.
  productDesignId String?
  productDesign   ProductDesign?  @relation(fields: [productDesignId], references: [id], onDelete: Restrict)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  priceAtOrder    Decimal
  pointsAtOrder   Int
  flavor          Flavor?
  customName      String?
  customFlavor    String?
  customImageUrl  String?
  customText      String?
  // Reference/inspiration photo the client sent by WhatsApp ("quiero algo así").
  // NOT the same as customImageUrl: that one is edible-print artwork and feeds
  // the day's print ZIP (findDayImageItems). referenceImageUrl is for the baker's
  // eyes only and stays out of the print gallery.
  referenceImageUrl String?
  // Shape snapshot — for a catalog line this is now the client's own pick at
  // add-to-cart time (Redonda/Corazón), not inherited from ProductDesign.shape
  // (that field only matters for designs outside this color-picker flow).
  // Hand-typed for a free line. Mandatory on every order item going forward.
  shape           String?
  // Color snapshot — the client's pick among that design's ProductDesignImage
  // rows. Null for a free line or a design with no color images loaded yet.
  color           String?
  relleno         String?
  customSize      String?
  createdAt       DateTime        @default(now())
}

model ProductDesign {
  id                     String       @id @default(uuid())
  name                   String
  category               ItemCategory
  shape                  String?
  // Cover photo — shown in catalog grids and as the default before a color is
  // picked. For a design with color variants (see `images`), this is just the
  // first color uploaded; the picker swaps the displayed photo client-side.
  imageUrl               String?
  allowsCustomImage      Boolean      @default(false)
  // True for a design where the client MUST upload their own print-ready image
  // (Melosa doesn't edit/design the print herself) — the $29.000 catalog's
  // "solo_imagen" and "texto_e_imagen" folders. Meaningless unless
  // allowsCustomImage is also true.
  requiresCustomImage    Boolean      @default(false)
  allowsCustomText       Boolean      @default(true)
  // Per-design cap on the custom phrase/number length. Defaults to 20 (the
  // $28.000 catalog's cap); the $29.000 "texto_e_imagen" designs use 10 so the
  // phrase fits on the smaller minicake print.
  customTextMaxLength    Int          @default(20)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  variants   ProductVariant[]
  orderItems OrderItem[]
  images     ProductDesignImage[]
}

// One photo per color a design is available in. Colors are freeform text (no
// master color list) since the source of truth is gretica's file naming, not a
// separate admin screen. `colorName` is unique per design, not globally.
model ProductDesignImage {
  id              String        @id @default(uuid())
  productDesignId String
  productDesign   ProductDesign @relation(fields: [productDesignId], references: [id], onDelete: Cascade)
  colorName       String
  imageUrl        String
  createdAt       DateTime      @default(now())

  @@unique([productDesignId, colorName])
}

model ProductVariant {
  id              String        @id @default(uuid())
  productDesignId String
  productDesign   ProductDesign @relation(fields: [productDesignId], references: [id], onDelete: Cascade)
  label           String
  price           Decimal
  points          Int
  // Minutes this variant consumes on the delivery timeline. Set per variant
  // from the admin catalog screen. Replaces `points` as the scheduling unit;
  // `points` stays only for historical OrderItem.pointsAtOrder records.
  prepMinutes     Int           @default(20)
  // Portion count this variant represents (5/10/15/20...), set explicitly from
  // the admin catalog screen. Drives the premium-relleno surcharge lookup in
  // pricing.ts — NOT parsed from `label` (that used to break silently whenever a
  // label didn't literally contain the word "porciones"). Null for a variant
  // that isn't sold by portions (e.g. a minicake, which is promo-locked anyway).
  portions        Int?
  enPromocion     Boolean       @default(false)
  createdAt       DateTime      @default(now())

  orderItems OrderItem[]
}

// One row per delivery day. cursorMinutes is the end of that day's booking
// queue (minutes from midnight; 840 = 2:00pm). It only ever moves forward: a cancelled order leaves its
// slot as a gap (rest time) and never pulls the cursor back. This row is also
// the lock point that serialises concurrent slot reservations for the same day.
model DaySchedule {
  id            String   @id @default(uuid())
  date          DateTime @unique @db.Date
  // Minutes from midnight; 840 = 2:00pm (opening).
  cursorMinutes Int      @default(840)
}

// A day Melosa manually closed from the app (vacation or one-off block). Only
// stops the public web booking flow — manual order creation from the app is
// unaffected, so she always retains override control.
model BlockedDay {
  id        String    @id @default(uuid())
  date      DateTime  @unique @db.Date
  type      BlockType
  createdAt DateTime  @default(now())
}

enum BlockType {
  VACATION
  MANUAL_BLOCK
}

enum OrderStatus {
  PENDING_REVIEW
  AWAITING_PAYMENT
  DEPOSIT_PAID
  FULLY_PAID
  COMPLETED
  CANCELLED
  EXPIRED
}

enum OrderSource {
  WEB_PUBLIC
  MANUAL
}

enum Flavor {
  VAINILLA
  CHOCOLATE
  // The alfajor minicake's fixed flavor — not a pickable option alongside
  // Vainilla/Chocolate, the ALFAJOR_CAKE design always locks to this.
  ALFAJOR
}

enum ItemCategory {
  CAKE
  ALFAJOR_CAKE
  ALFAJOR_UNIT
  CUPCAKE
  DESSERT
}
